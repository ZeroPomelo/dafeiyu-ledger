<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colOverlay">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sheet_bg"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="记一笔"
            android:textColor="?attr/colText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/sheetAmount"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/edit_bg"
            android:hint="金额"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="?attr/colText"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.dafeiyu.ledger.FlowLayout
            android:id="@+id/sheetChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/sheetNote"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_bg"
            android:hint="备注（可选）"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="40"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="?attr/colText"
            android:textSize="15sp" />

        <Button
            android:id="@+id/sheetSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_expense"
            android:stateListAnimator="@null"
            android:text="保 存"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
